<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_1"
            style="@style/DialpadKey"
            android:text="1" />

        <Button
            android:id="@+id/key_2"
            style="@style/DialpadKey"
            android:text="2" />

        <Button
            android:id="@+id/key_3"
            style="@style/DialpadKey"
            android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_4"
            style="@style/DialpadKey"
            android:text="4" />

        <Button
            android:id="@+id/key_5"
            style="@style/DialpadKey"
            android:text="5" />

        <Button
            android:id="@+id/key_6"
            style="@style/DialpadKey"
            android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_7"
            style="@style/DialpadKey"
            android:text="7" />

        <Button
            android:id="@+id/key_8"
            style="@style/DialpadKey"
            android:text="8" />

        <Button
            android:id="@+id/key_9"
            style="@style/DialpadKey"
            android:text="9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_star"
            style="@style/DialpadKey"
            android:text="✱" />

        <Button
            android:id="@+id/key_0"
            style="@style/DialpadKey"
            android:text="0" />

        <Button
            android:id="@+id/key_hash"
            style="@style/DialpadKey"
            android:text="#" />
    </LinearLayout>
</LinearLayout>
